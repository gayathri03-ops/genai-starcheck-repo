APP_NAME=examate-rag
ENVIRONMENT=local
# Add API keys here later. Never commit the real .env file.
# Names only, no real keys.

LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=0.5

# Second model used only when the main one is unavailable. Empty = no fallback.
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=

PRICE_INPUT_PER_MILLION=0
PRICE_OUTPUT_PER_MILLION=0
COST_LOG_PATH=logs/cost.jsonl
